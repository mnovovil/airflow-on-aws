# Copy to local/.env and adjust. Never commit the copy — local/.env is gitignored.

# Which profile in ~/.aws the DAG's boto3 calls use — the name of a profile on your
# own machine, so replace it. It must be able to start/stop the worker, send SSM
# commands, read the artifacts bucket and read airflow/* secrets.
AWS_PROFILE=your-profile
AWS_REGION=eu-north-1

# Airflow UI login. Local-only, never leaves your machine.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Host port for the UI, in case 8080 is taken.
AIRFLOW_PORT=8080

# ---------------------------------------------------------------- no-Terraform mode
#
# Leave both unset for the normal path, where the DAG resolves these from Secrets
# Manager exactly as it does on MWAA — which needs `terraform apply` to have run.
#
# Set them to point the DAG at resources you name yourself, and Secrets Manager is
# bypassed. instance_id and artifacts_bucket still have to exist; this skips the
# secrets, not the infrastructure.
#
# AIRFLOW_VAR_ICE_CONFIG={"instance_id":"i-0123456789abcdef0","artifacts_bucket":"ice-artifacts-123456789012","source_bucket":"example-dem","report_prefix":"reports","email_to":"recipient@example.com","region":"eu-north-1","ssm_log_group":"/aws/ssm/ice-gdal-worker","start_timeout":300,"gdal_timeout":1800}
# AIRFLOW_VAR_GDAL_IMAGE_URI=123456789012.dkr.ecr.eu-north-1.amazonaws.com/ice-gdal-report:latest
AIRFLOW_UID=1000
